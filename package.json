{
  "name": "gladys-gira",
  "version": "0.1.1",
  "private": true,
  "description": "Gladys Assistant external integration for Gira X1, HomeServer and FacilityServer, through the local Gira IoT REST API v2: lights, dimmers, covers and scenes; writes off by default, stops never held back, certificate pinned. Unofficial, not affiliated with Gira.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --test-timeout=60000",
    "audit": "npm audit --omit=dev",
    "cover": "node scripts/cover.mjs cover.png",
    "validate:manifest": "npx --yes github:GladysAssistant/integration-store ."
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.0"
  },
  "license": "Apache-2.0"
}
